{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-session-search-worker",
  "compatibility_date": "2026-09-26",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llm-session-search",
      "database_id": "c067a8b0-1545-4907-8bc4-0cd8067d6152",
      "migrations_dir": "migrations"
    }
  ],
  "main": "src/index.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "preview_urls": false,
  "vars": {
    "ALLOWED_EMAIL": ""
  },
  "access": {
    "dev": {
      "aud": "local-session-search",
      "identity": {
        "email": "you@example.com"
      }
    }
  },
  "workers_dev": false
}
